      "items": [
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 0,
          "searchText": "أوفوا ٱلكيل ولا تكونوا من ٱلمخسرين",
          "segments": [
            {
              "text": "أَوۡفُوا۟ ٱلۡكَيۡلَ وَلَا تَكُونُوا۟ مِنَ ٱلۡمُخۡسِرِينَ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 0,
          "searchText": "كذلك سلكنه فى قلوب ٱلمجرمين",
          "segments": [
            {
              "text": "كَذَٰلِكَ سَلَكۡنَٰهُ فِى قُلُوبِ ٱلۡمُجۡرِمِينَ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 1,
          "searchText": "ولا تنزعوا فتفشلوا وتذهب ريحكم",
          "segments": [
            {
              "text": "وَلَا تَنَٰزَعُوا۟ فَتَفۡشَلُوا۟ وَتَذۡهَبَ رِيحُكُمۡ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 1,
          "searchText": "وأورثكم أرضهم وديرهم وأمولهم",
          "segments": [
            {
              "text": "وَأَوۡرَثَكُمۡ أَرۡضَهُمۡ وَدِيَٰرَهُمۡ وَأَمۡوَٰلَهُمۡ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 2,
          "searchText": "يصلح لكم أعملكم ويغفر لكم",
          "segments": [
            {
              "text": "يُصۡلِحۡ لَكُمۡ أَعۡمَٰلَكُمۡ وَيَغۡفِرۡ لَكُمۡ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 2,
          "searchText": "فأعرضوا فأرسلنا عليهم سيل ٱلعرم",
          "segments": [
            {
              "text": "فَأَعۡرَضُوا۟ فَأَرۡسَلۡنَا عَلَيۡهِمۡ سَيۡلَ ٱلۡعَرِمِ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 3,
          "searchText": "وأمرت أن أكون من ٱلمسلمين",
          "segments": [
            {
              "text": "وَأُمِرۡتُ أَنۡ أَكُونَ مِنَ ٱلۡمُسۡلِمِينَ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 3,
          "searchText": "وأقيموا ٱلوزن بٱلقسط ولا تخسروا",
          "segments": [
            {
              "text": "وَأَقِيمُوا۟ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُوا۟",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 4,
          "searchText": "ولقد سبقت كلمتنا لعبادنا ٱلمرسلين",
          "segments": [
            {
              "text": "وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 4,
          "searchText": "فنادوا صاحبهم فتعاطى فعقر",
          "segments": [
            {
              "text": "فَنَادَوۡا۟ صَاحِبَهُمۡ فَتَعَاطَىٰ فَعَقَرَ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 5,
          "searchText": "ونصرنهم فكانوا هم ٱلغلبين",
          "segments": [
            {
              "text": "وَنَصَرۡنَٰهُمۡ فَكَانُوا۟ هُمُ ٱلۡغَٰلِبِينَ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 5,
          "searchText": "وتركنا عليهما فى ٱلأخرين",
          "segments": [
            {
              "text": "وَتَرَكۡنَا عَلَيۡهِمَا فِى ٱلۡأٓخِرِينَ",
              "role": "base"
            }
          ]
        }
      ]
    },
    {
      "kind": "sentences",
