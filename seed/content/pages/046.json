      "items": [
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 0,
          "searchText": "فكبكبوا فيها هم وٱلغاون وجنود إبليس أجمعون",
          "segments": [
            {
              "text": "فَكُبۡكِبُوا۟ فِيهَا هُمۡ وَٱلۡغَاوُۥنَ وَجُنُودُ إِبۡلِيسَ أَجۡمَعُونَ",
              "role": "base"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 1,
          "searchText": "له ٱلحمد فى ٱلأولى وٱلأخرة وله ٱلحكم وإليه ترجعون",
          "segments": [
            {
              "text": "لَهُ ٱلۡحَمۡدُ فِى ٱلۡأُولَىٰ وَٱلۡأٓخِرَةِ وَلَهُ ٱلۡحُكۡمُ وَإِلَيۡهِ تُرۡجَعُونَ",
              "role": "base"
            }
          ]
        }
      ]
