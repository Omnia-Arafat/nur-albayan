      "items": [
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 0,
          "searchText": "النجوم",
          "segments": [
            {
              "text": "النُّجُومُ",
              "role": "target"
            }
          ]
        },
        {
          "cardType": "normal",
          "script": "uthmani",
          "rowBand": 1,
          "searchText": "النجوم فى السماء إحدى ظواهر قدرة الله - جل وعلا - فهى زينة تبعث الشعور بالجمال فى نفس من يراها وهى كاللؤلؤ المنثور، كما جعلها الله هداية لمن يمشى فى الصحراء، وهداية للسفن ليلا، وللنجوم مواقع ثابتة وثبوت هذه المواقع هو الذى يعين على الاهتداء بها، وقد أشار القرآن الكريم إلى هذا فى قوله تعالى: )وبٱلنجم هم يهتدون( ومواقع النجوم تدل على دقة صنع الخالق وعلى الإحكام فى بناء هذا الكون الذى تدور نجومه وشموسه وكواكبه فى أفلاك لا تحيد عنها، فسبحان الخلاق العظيم.",
          "segments": [
            {
              "text": "النُّجُومُ فِى السَّمَاءِ إِحْدَى ظَوَاهِرِ قُدْرَةِ اللَّهِ",
              "role": "base"
            },
            {
              "text": " - ",
              "role": "separator"
            },
            {
              "text": "جَلَّ وَعَلَا",
              "role": "base"
            },
            {
              "text": " - ",
              "role": "separator"
            },
            {
              "text": "فَهِىَ زِينَةٌ تَبْعَثُ الشُّعُورَ بِالْجَمَالِ فِى نَفْسِ مَنْ يَرَاهَا وَهِىَ كَاللُّؤْلُؤِ الْمَنْثُورِ، كَمَا جَعَلَهَا اللَّهُ هِدَايَةً لِمَنْ يَمْشِى فِى الصَّحْرَاءِ، وَهِدَايَةً لِلسُّفُنِ لَيْلًا، وَلِلنُّجُومِ مَوَاقِعُ ثَابِتَةٌ وَثُبُوتُ هَذِهِ الْمَوَاقِعِ هُوَ الَّذِى يُعِينُ عَلَى الِاهْتِدَاءِ بِهَا، وَقَدْ أَشَارَ الْقُرْآنُ الْكَرِيمُ إِلَى هَذَا فِى قَوْلِهِ تَعَالَى: ",
              "role": "base"
            },
            {
              "text": ")وَبِٱلنَّجۡمِ هُمۡ يَهۡتَدُونَ(",
              "role": "target"
            },
            {
              "text": " وَمَوَاقِعُ النُّجُومِ تَدُلُّ عَلَى دِقَّةِ صُنْعِ الْخَالِقِ وَعَلَى الْإِحْكَامِ فِى بِنَاءِ هَذَا الْكَوْنِ الَّذِى تَدُورُ نُجُومُهُ وَشُمُوسُهُ وَكَوَاكِبُهُ فِى أَفْلَاكٍ لَا تَحِيدُ عَنْهَا، فَسُبْحَانَ الْخَلَّاقِ الْعَظِيمِ.",
              "role": "base"
            }
          ]
        }
      ]
    }
  ],
