# Supabase Postgres connection string used by the app at runtime and by migrations
# (Project settings > Database > Connection string > Session pooler, port 5432).
# The transaction pooler (port 6543) hangs on the concurrent queries a page makes.
DATABASE_URL=
# Connections each server instance may hold (default 3); the session pooler allows 15 in total.
DATABASE_POOL_MAX=
# Optional separate connection for `pnpm db:migrate` and `pnpm db:seed`; falls back to DATABASE_URL.
DATABASE_URL_DIRECT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public address of the site, used in sign-in email links.
NEXT_PUBLIC_SITE_URL=
# Comma-separated emails that become admins on their first sign-in.
ADMIN_EMAILS=
